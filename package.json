{
  "name": "cypress-automation-framework",
  "version": "1.0.0",
  "description": "Cypress automation framework for Facebook sign up",
  "main": "index.js",
  "scripts": {
    "test:staging": "npx cypress run --env APP_ENV=staging",
    "test:preprod": "npx cypress run --env APP_ENV=preprod",
    "test:prod": "npx cypress run --env APP_ENV=prod",
    "test:ui:staging": "npx cypress open --env APP_ENV=staging",
    "test:ui:preprod": "npx cypress open --env APP_ENV=preprod",
    "test:ui:prod": "npx cypress open --env APP_ENV=prod"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "cypress": "^13.8.1",
    "cypress-mochawesome-reporter": "^3.8.4",
    "dotenv": "^16.4.5"
  }
}
